    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@session/contracts": "0.0.0",
    "@session/protocol-runner": "0.0.0",
    "better-sqlite3": "13.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13"
  }
}
