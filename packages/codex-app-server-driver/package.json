{
  "name": "@agent-relay/codex-app-server-driver",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "canary": "tsx --conditions=development scripts/run-live-canary.ts",
    "contract:check": "vitest run test/contract.test.ts --no-file-parallelism",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json"
  },
  "dependencies": {
    "@agent-relay/runner-bridge": "workspace:*",
    "@session/contracts": "0.0.0",
    "@session/protocol-runner": "0.0.0",
    "zod": "4.4.3"
  }
}
