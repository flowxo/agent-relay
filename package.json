{
  "name": "@flowxo/agent-relay",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "Local-first attention and control layer for concurrent coding agents",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flowxo/agent-relay.git"
  },
  "bugs": {
    "url": "https://github.com/flowxo/agent-relay/issues"
  },
  "homepage": "https://github.com/flowxo/agent-relay#readme",
  "keywords": [
    "agent",
    "codex",
    "claude-code",
    "cursor",
    "telegram",
    "developer-tools"
  ],
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "directory": ".artifacts/package",
    "linkDirectory": false,
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm format:check && pnpm governance:check && pnpm docs:check && pnpm fixtures:check && pnpm secrets:check && pnpm release:policy:check && pnpm lint && pnpm typecheck && pnpm test && pnpm capabilities:check && pnpm contracts:notifications && pnpm dist:check && pnpm package:check && pnpm package:hosted:check && pnpm package:lifecycle:check",
    "capabilities:generate": "pnpm --filter @agent-relay/harnesses capabilities:generate",
    "capabilities:check": "pnpm --filter @agent-relay/harnesses capabilities:check",
    "contracts:preinstall": "node contracts/scripts/verify-notifications.mjs",
    "contracts:notifications": "node --test contracts/test/*.node-test.mjs && pnpm --filter @agent-relay/notifications-transport contract:check && node contracts/scripts/write-notifications-result.mjs",
    "dist:check": "pnpm -r build && node apps/relay/dist/cli.js capabilities && pnpm --filter @agent-relay/relay web:package:check",
    "docs:check": "node scripts/check-public-docs.mjs",
    "fixtures:check": "node --test scripts/test/check-fixtures.node-test.mjs && node scripts/check-fixtures.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "governance:check": "node scripts/check-governance.mjs",
    "lint": "eslint .",
    "notifications:contract:check": "pnpm contracts:notifications",
    "package:build": "node scripts/build-package.mjs",
    "package:check": "node scripts/check-package.mjs",
    "package:hosted:check": "node scripts/check-hosted-package.mjs",
    "package:lifecycle:check": "node scripts/check-package-lifecycle.mjs",
    "prepack": "pnpm package:build",
    "release:bundle": "node scripts/build-release.mjs",
    "release:bundle:verify": "node scripts/verify-release-bundle.mjs",
    "release:exit": "node scripts/check-release-exit.mjs",
    "release:policy:check": "node --test scripts/test/release-bundle.node-test.mjs scripts/test/release-exit-policy.node-test.mjs scripts/test/release-policy.node-test.mjs scripts/test/repository-secrets.node-test.mjs && node scripts/check-release-workflow.mjs",
    "relay": "pnpm --filter @agent-relay/relay dev",
    "secrets:check": "node scripts/check-repository-secrets.mjs",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.0",
    "@types/node": "24.13.3",
    "ajv": "8.20.0",
    "esbuild": "0.28.1",
    "eslint": "10.7.0",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "better-sqlite3": "13.0.1",
    "zod": "4.4.3"
  }
}
