{
  "name": "@agent-relay/relay",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "agent-relay": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-web-assets.mjs",
    "web:package:check": "node scripts/check-web-package.mjs",
    "dev": "tsx --conditions=development src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agent-relay/core": "workspace:*",
    "@agent-relay/harnesses": "workspace:*",
    "@agent-relay/notifications-transport": "workspace:*",
    "@agent-relay/protocol": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@flowxo/notifications-contract-mock": "file:../../vendor/notifications-c0/flowxo-notifications-contract-mock-1.0.0-rc.1.tgz"
  }
}
