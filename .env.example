# Optional daemon authentication. Use a high-entropy local secret.
AGENT_RELAY_DAEMON_TOKEN=

# Exact transport override: fake, telegram, webhook, or whooshbang.
# Credentials never select a transport. Omit to use the private durable
# selection, then fake.
AGENT_RELAY_TRANSPORT=fake

# Direct Telegram credentials are read only when telegram is selected.
AGENT_RELAY_TELEGRAM_TOKEN=
AGENT_RELAY_TELEGRAM_CHAT_ID=
AGENT_RELAY_TELEGRAM_OPERATOR_ID=
# "poll" works for a loopback daemon; "webhook" requires an external bridge.
AGENT_RELAY_TELEGRAM_UPDATE_MODE=poll
AGENT_RELAY_TELEGRAM_WEBHOOK_SECRET=
# Exact-equivalent routine notifications coalesce for 60 seconds; 0 disables.
AGENT_RELAY_COALESCE_WINDOW_MS=60000
# Before a real transport starts draining, stale queued events older than one
# hour become visible dead letters. Still-open requests and proven owned-child
# crashes are exempt. Set 0 only to disable this startup/replay safety guard.
AGENT_RELAY_STARTUP_BACKLOG_MAX_AGE_MS=3600000
# Set to 0 (or pass daemon --no-web) to disable every local web route.
AGENT_RELAY_WEB_ENABLED=1

# Optional signed outbound webhook. Prefer `agent-relay webhook configure
# --secret-stdin` for private file-backed setup. Non-loopback URLs require HTTPS.
AGENT_RELAY_WEBHOOK_URL=
AGENT_RELAY_WEBHOOK_SECRET=
AGENT_RELAY_WEBHOOK_TIMEOUT_MS=5000

# Optional hosted WhooshBang OAuth bootstrap. Keep the private project,
# subscriber, and notifier identifiers in the process environment rather than
# command arguments. Agent Relay persists only the generated narrow credential.
AGENT_RELAY_WHOOSHBANG_BASE_URL=
AGENT_RELAY_WHOOSHBANG_PROJECT_SELECTOR=
AGENT_RELAY_WHOOSHBANG_ENVIRONMENT=test
AGENT_RELAY_WHOOSHBANG_SUBSCRIBER_ID=
AGENT_RELAY_WHOOSHBANG_NOTIFIER_ID=default

# Optional runtime locations. Defaults stay under ~/.agent-relay.
AGENT_RELAY_DAEMON_URL=http://127.0.0.1:4317
AGENT_RELAY_STATE_DIR=

# Supervised stop requests default to 24 hours.
AGENT_RELAY_LATE_RESUME_TTL_MS=86400000
AGENT_RELAY_RETENTION_DAYS=30
AGENT_RELAY_DEAD_LETTER_RETENTION_DAYS=90
AGENT_RELAY_DIAGNOSTIC_RETENTION_DAYS=90
AGENT_RELAY_LOG_PATH=
AGENT_RELAY_LOG_MAX_BYTES=4194304
AGENT_RELAY_LOG_FILES=5
